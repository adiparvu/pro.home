    "ARIA is analyzing your property…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ARIA analysiert Ihr Grundstück…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ARIA is analyzing your property…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ARIA analyse votre propriété…"
          }
        },
        "nl": {
          "stringUnit": {
