    "Restrictions apply at the device level. %@ will only see the enabled sections. Assigned tasks will automatically send them a notification.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschränkungen gelten auf Geräteebene. %@ sieht nur die aktivierten Abschnitte. Zugewiesene Aufgaben senden automatisch eine Benachrichtigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restrictions apply at the device level. %@ will only see the enabled sections. Assigned tasks will automatically send them a notification."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les restrictions s'appliquent au niveau de l'appareil. %@ ne verra que les sections activées. Les tâches assignées lui enverront automatiquement une notification."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beperkingen gelden op apparaatniveau. %@ ziet alleen de ingeschakelde secties. Toegewezen taken sturen automatisch een melding."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restricțiile se aplică la nivel de dispozitiv. %@ va vedea doar secțiunile activate. Sarcinile atribuite îi vor trimite automat o notificare."
          }
        }
      }
    },
