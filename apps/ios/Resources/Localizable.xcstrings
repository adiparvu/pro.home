    "lang_instant_rebuild": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache aktualisiert sich sofort, wenn Sie eine Option wählen. Einige System-UI-Elemente können weiterhin der Gerätesprache folgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language updates instantly when you select an option. Some system UI elements may still follow the device language."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue se met à jour instantanément lorsque vous sélectionnez une option. Certains éléments d'interface système peuvent toujours suivre la langue de l'appareil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De taal wordt direct bijgewerkt wanneer u een optie selecteert. Sommige systeem-UI-elementen kunnen de apparaattaal blijven volgen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limba se actualizează instant când selectezi o opțiune. Unele elemente UI de sistem pot urma în continuare limba dispozitivului."
          }
        }
      }
    },
