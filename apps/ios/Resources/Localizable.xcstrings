        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveillez les bords du toit et retirez l'accumulation de neige selon les besoins."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer dakranden en verwijder sneeuwophoping indien nodig."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitorizează marginile acoperișului și îndepărtează zăpada acumulată după necesitate."
