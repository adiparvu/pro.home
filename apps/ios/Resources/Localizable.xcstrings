    "Save paint colors for each room so you can easily reorder or touch up later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie Farben für jeden Raum, damit Sie später leicht nachbestellen oder ausbessern können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save paint colors for each room so you can easily reorder or touch up later."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez les couleurs de peinture pour chaque pièce afin de les commander à nouveau ou de les retoucher facilement plus tard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla verfkleuren op voor elke kamer zodat u ze later eenvoudig opnieuw kunt bestellen of bijwerken."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează culorile de vopsea pentru fiecare cameră ca să poți recomanda sau retușa ușor mai târziu."
          }
        }
      }
    },
