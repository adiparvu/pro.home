    "This device doesn't have a LiDAR sensor. 3D room capture is available on iPhone Pro and iPad Pro models. You can still add floor plans, blueprints, and photos.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat keinen LiDAR-Sensor. Sie können weiterhin Grundrisse, Blaupausen und Fotos hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device doesn't have a LiDAR sensor. 3D room capture is available on iPhone Pro and iPad Pro models. You can still add floor plans, blueprints, and photos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n'a pas de capteur LiDAR. Vous pouvez toujours ajouter des plans, des schémas et des photos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat heeft geen LiDAR-sensor. U kunt nog steeds plattegronden, blauwdrukken en foto's toevoegen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv nu are sensor LiDAR. Poți adăuga planuri de etaj, schițe și fotografii."
          }
        }
      }
    },
    "This information will be visible to anyone who scans the QR code of this item. Only share what you are comfortable with.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Informationen sind für jeden sichtbar, der den QR-Code dieses Artikels scannt. Teilen Sie nur, womit Sie sich wohl fühlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This information will be visible to anyone who scans the QR code of this item. Only share what you are comfortable with."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces informations seront visibles par quiconque scanne le code QR de cet article. Ne partagez que ce avec quoi vous êtes à l'aise."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze informatie is zichtbaar voor iedereen die de QR-code van dit artikel scant. Deel alleen wat u prettig vindt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste informații vor fi vizibile oricui scanează codul QR al articolului. Distribuie doar ce ești confortabil să împărtășești."
          }
        }
      }
    },
