    "aria_welcome": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo! Ich bin ARIA, Ihr KI-Immobilienassistent, betrieben von Claude. Ich kann Ihre Aufgaben, Finanzen und Immobiliendaten einsehen. Fragen Sie mich alles!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi! I'm ARIA, your AI property assistant powered by Claude. I can see your tasks, finances, and property data. Ask me anything!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour ! Je suis ARIA, votre assistant IA immobilier propulsé par Claude. Je peux voir vos tâches, vos finances et les données de votre propriété. Posez-moi n'importe quelle question !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo! Ik ben ARIA, uw AI-eigendomsassistent, aangedreven door Claude. Ik kan uw taken, financiën en eigendomsgegevens bekijken. Stel me gerust een vraag!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bună! Sunt ARIA, asistentul tău AI de proprietate, alimentat de Claude. Pot vedea sarcinile, finanțele și datele proprietății tale. Întreabă-mă orice!"
          }
        }
      }
    },
