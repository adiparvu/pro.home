    "The Health Score (0–100) is calculated from overdue tasks, expiring documents, and maintenance frequency. Complete tasks and renew documents to improve it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gesundheitsscore (0–100) wird aus überfälligen Aufgaben, ablaufenden Dokumenten und Wartungshäufigkeit berechnet. Schließen Sie Aufgaben ab und erneuern Sie Dokumente, um ihn zu verbessern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Health Score (0–100) is calculated from overdue tasks, expiring documents, and maintenance frequency. Complete tasks and renew documents to improve it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le score de santé (0–100) est calculé à partir des tâches en retard, des documents expirant et de la fréquence de maintenance. Complétez les tâches et renouvelez les documents pour l'améliorer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gezondheidsscore (0–100) wordt berekend op basis van achterstallige taken, verlopende documenten en onderhoudsfrequentie. Voltooi taken en vernieuw documenten om het te verbeteren."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorul de sănătate (0–100) este calculat din sarcinile întârziate, documentele care expiră și frecvența întreținerii. Finalizează sarcini și reînnoiește documente pentru a-l îmbunătăți."
          }
        }
      }
    },
