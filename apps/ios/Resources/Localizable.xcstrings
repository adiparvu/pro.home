    "language_follow_ios_desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App passt sich automatisch an die in den iOS-Einstellungen festgelegte Sprache an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app adapts automatically to the language set in iOS Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application s'adapte automatiquement à la langue définie dans les réglages iOS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app past zich automatisch aan aan de taal ingesteld in iOS-instellingen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația se adaptează automat la limba setată în Setări iOS."
          }
        }
      }
    },
    "language_ios_tip": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können auch eine sprachspezifische Einstellung unter iOS-Einstellungen → PRVIO → Sprache vornehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also set a per-app language in iOS Settings → PRVIO → Language."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez également définir une langue par application dans Réglages iOS → PRVIO → Langue."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U kunt ook een taal per app instellen via iOS-instellingen → PRVIO → Taal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți seta limba per-aplicație și din Setări iOS → PRVIO → Limbă."
          }
        }
      }
    },
