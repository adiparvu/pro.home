    "Go to Settings → My Property → tap the + button. Fill in the address, type, and optional photo. You can manage multiple properties from the same account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen Sie zu Einstellungen → Meine Immobilie → tippen Sie auf die + Schaltfläche. Geben Sie Adresse, Typ und optionales Foto ein. Sie können mehrere Immobilien vom selben Konto verwalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Settings → My Property → tap the + button. Fill in the address, type, and optional photo. You can manage multiple properties from the same account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans Paramètres → Ma propriété → appuyez sur le bouton +. Remplissez l'adresse, le type et une photo optionnelle. Vous pouvez gérer plusieurs propriétés depuis le même compte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga naar Instellingen → Mijn woning → tik op de + knop. Vul het adres, type en optionele foto in. U kunt meerdere woningen beheren vanuit hetzelfde account."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesează Setări → Proprietatea mea → apasă butonul +. Completează adresa, tipul și fotografia opțională. Poți gestiona mai multe proprietăți din același cont."
          }
        }
      }
    },
