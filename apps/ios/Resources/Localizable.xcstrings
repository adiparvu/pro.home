          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple AirTag live location requires the Find My app (private Apple API). Save the name here as a reference, then open Find My for live tracking."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation live AirTag nécessite l'app Localiser (API privée Apple). Sauvegardez le nom ici comme référence, puis ouvrez Localiser pour le suivi en direct."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
