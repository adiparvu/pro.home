    "If a page has a single active action, the button triggers it directly. With multiple actions, the button opens a menu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat eine Seite eine einzelne aktive Aktion, löst die Schaltfläche diese direkt aus. Bei mehreren Aktionen öffnet die Schaltfläche ein Menü."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a page has a single active action, the button triggers it directly. With multiple actions, the button opens a menu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si une page a une seule action active, le bouton la déclenche directement. Avec plusieurs actions, le bouton ouvre un menu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een pagina een enkele actieve actie heeft, activeert de knop deze direct. Met meerdere acties opent de knop een menu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă o pagină are o singură acțiune activă, butonul o declanșează direct. Cu mai multe acțiuni, butonul deschide un meniu."
          }
        }
      }
    },
