        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da. Accesează Profilul tău → Securitate & Confidențialitate → Exportă datele mele. Vei primi un fișier JSON cu toate sarcinile, finanțele, documentele și altele."
          }
        }
      }
    },
