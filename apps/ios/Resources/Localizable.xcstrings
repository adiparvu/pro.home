    },
    "Yes. Go to Settings → Family Members → tap the invite icon. Enter their email — they'll receive a link to join your property." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes. Go to Settings → Family Members → tap the invite icon. Enter their email — they'll receive a link to join your property."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da. Accesează Setări → Membrii familiei → apasă iconița de invitație. Introdu e-mailul lor — vor primi un link pentru a se alătura proprietății tale."
          }
        }
      }
    },
    "Yes. Go to your Profile → Security & Privacy → Export My Data. You'll get a JSON file with all your tasks, finances, documents, and more." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
