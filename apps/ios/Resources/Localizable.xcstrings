    "Record where you ran cables, water, gas or drainage underground — with depth and location — so you never dig blind again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfassen Sie, wo Sie Kabel, Wasser, Gas oder Entwässerung unter der Erde verlegt haben — mit Tiefe und Standort — damit Sie nie wieder blind graben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record where you ran cables, water, gas or drainage underground — with depth and location — so you never dig blind again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez où vous avez tiré des câbles, de l'eau, du gaz ou des drainages souterrains — avec profondeur et emplacement — pour ne plus jamais creuser à l'aveugle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg vast waar u kabels, water, gas of afvoer ondergronds heeft aangelegd — met diepte en locatie — zodat u nooit meer blind graaft."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează unde ai montat cabluri, apă, gaz sau drenaj subteran — cu adâncime și locație — ca să nu mai sapi orbește."
          }
        }
      }
    },
