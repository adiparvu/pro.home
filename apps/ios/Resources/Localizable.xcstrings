            "value": "Sediment ablassen, um Effizienz zu verbessern und Lebensdauer zu verlängern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drain sediment to improve efficiency and extend lifespan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Purgez les sédiments pour améliorer l'efficacité et prolonger la durée de vie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap bezinksel af om de efficiëntie te verbeteren en de levensduur te verlengen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scurge sedimentele pentru a îmbunătăți eficiența și a prelungi durata de viață."
          }
        }
      }
