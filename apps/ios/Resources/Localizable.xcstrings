    "Remove and rinse screens to improve airflow and visibility.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fliegengitter entfernen und spülen, um Luftstrom und Sichtbarkeit zu verbessern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove and rinse screens to improve airflow and visibility."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez et rincez les moustiquaires pour améliorer la circulation d'air et la visibilité."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder en spoel vliegengaas om luchtstroom en zichtbaarheid te verbeteren."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scoate și clătește plasele pentru a îmbunătăți fluxul de aer și vizibilitatea."
          }
        }
      }
    },
    "Remove debris left from winter and early spring leaves.": {
