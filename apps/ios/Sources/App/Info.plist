<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ro</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>PRVIO</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>NSCameraUsageDescription</key>
	<string>Used to scan documents and capture property photos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Used to attach photos to property records and tasks.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Used for voice search to find tasks, documents, and finances hands-free.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Used to convert your voice into search queries across your property data.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Used to share your location in Family Chat and tag item locations in Inventory.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to unlock PRVIO quickly and securely.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Used to sync your maintenance tasks and reminders with Apple Calendar.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Used to add family birthdays as annual reminders in Apple Calendar.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Used to add overdue tasks to Apple Reminders for quick action.</string>
	<key>NSContactsUsageDescription</key>
	<string>Used to sync family members to your iPhone Contacts.</string>
	<key>NSSiriUsageDescription</key>
	<string>Used to add tasks, water plants, and open PRVIO with your voice.</string>
	<key>NFCReaderUsageDescription</key>
	<string>Used to scan NFC tags on appliances and rooms to open them instantly in PRVIO.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Used to communicate with local IoT controllers (ESP32, Raspberry Pi, RS485 Modbus gateways) on your home network.</string>
	<key>NSHomeKitUsageDescription</key>
	<string>Used to read and control HomeKit smart devices connected to your property.</string>
	<key>NSGroupActivitiesUsageDescription</key>
	<string>Used to share the Digital Twin with family members during a FaceTime call.</string>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.prvio.app</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>PRVIO</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.prvio.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>prvio</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
		<string>waze</string>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.prvio.task</string>
		<string>com.prvio.plants</string>
		<string>com.prvio.chat</string>
		<string>com.prvio.shopping</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.prvio.spotlight.refresh</string>
		<string>com.prvio.app.proactive</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>plus.circle.fill</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>New Task</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.prvio.action.addtask</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>leaf.fill</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>My Plants</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.prvio.action.plants</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>cart.fill</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Shopping List</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.prvio.action.shopping</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>bubble.left.and.bubble.right.fill</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Family Chat</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.prvio.action.chat</string>
		</dict>
	</array>
</dict>
</plist>
