<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SOURCE OF TRUTH IS project.yml, NOT this file. XcodeGen regenerates this
  file from the PRVIO target's `entitlements.properties` on every `generate`,
  so anything added here that is not also in project.yml is silently dropped
  at build time. This checked-in copy mirrors those properties exactly so the
  repo and the built binary agree.

  Only capabilities the app actually uses are declared. Earlier this file also
  listed iCloud, Siri, Sign in with Apple, Family Controls, Data Protection and
  Apple Pay, but the code uses none of them, so they were dead entitlements and
  were removed (the Apple Pay code was deleted too). Add a key in BOTH places
  (here and project.yml properties) only when the App ID has the matching
  capability enabled, or codesign will fail.
-->
<plist version="1.0">
<dict>
	<!-- Apple Push Notifications (APNs) — chat DM/group pushes. -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- Shared container with the widgets/watch (SharedDataStore snapshot). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.prvio.app</string>
	</array>

	<!-- NFC / HomeKit / WeatherKit are intentionally not declared yet: NFC as-is
	     fails App Store upload validation on SDK 26.5 (ITMS-90778), and all three
	     were already stripped/non-functional. Restore in a follow-up once each is
	     verified to pass upload validation. Keep this file in sync with the
	     project.yml `properties` block. -->
</dict>
</plist>
