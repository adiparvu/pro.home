<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SOURCE OF TRUTH IS project.yml, NOT this file. XcodeGen regenerates this
  file from the PRVIO target's `entitlements.properties` on every `generate`,
  so anything added here that is not also in project.yml is silently dropped
  at build time. This checked-in copy mirrors those properties exactly so the
  repo and the built binary agree.

  Only capabilities the app actually uses are declared. Earlier this file also
  listed iCloud, Siri, Sign in with Apple, Family Controls and Data Protection,
  but the code uses none of them (Apple Pay is the only other real capability —
  see note below), so they were dead entitlements and were removed. Add a key
  in BOTH places (here and project.yml properties) only when the App ID has the
  matching capability enabled, or codesign will fail.

  Apple Pay is NOT declared here yet: ApplePayService builds a real
  PKPaymentRequest but PKPaymentAuthorizationController.canMakePayments()
  degrades to false without the entitlement, so payments are simply
  unavailable until the merchant ID + APPLE_PAY capability are wired up.
-->
<plist version="1.0">
<dict>
	<!-- Apple Push Notifications (APNs) — chat DM/group pushes. -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- Shared container with the widgets/watch (SharedDataStore snapshot). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.prvio.app</string>
	</array>

	<!-- WeatherKit — property weather card. -->
	<key>com.apple.developer.weatherkit</key>
	<true/>

	<!-- NFC Tag Reading — NFC wallet / tag scan. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>NDEF</string>
	</array>

	<!-- HomeKit — Cameras page (HMHomeManager). -->
	<key>com.apple.developer.homekit</key>
	<true/>
</dict>
</plist>
