<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SOURCE OF TRUTH IS project.yml, NOT this file. XcodeGen regenerates this
  file from the PRVIO target's `entitlements.properties` on every `generate`,
  so anything added here that is not also in project.yml is silently dropped
  at build time. This checked-in copy mirrors those properties exactly so the
  repo and the built binary agree.

  Only capabilities the app actually uses are declared. NFC stays out on
  purpose: restoring it as-is fails App Store upload validation on SDK 26.5
  (ITMS-90778 "NDEF is disallowed"). Add a key in BOTH places (here and
  project.yml properties) only when the App ID has the matching capability
  enabled, or codesign will fail.
-->
<plist version="1.0">
<dict>
	<!-- Apple Push Notifications (APNs) — chat DM/group pushes. -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- Shared container with the widgets/watch (SharedDataStore snapshot). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.prvio.app</string>
	</array>

	<!-- Communication Notifications — sender avatars on chat pushes. -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>

	<!-- WeatherKit — the dashboard weather card (WeatherService). -->
	<key>com.apple.developer.weatherkit</key>
	<true/>

	<!-- HomeKit — the smart-home dashboard (SmartHomeService/HomeKitService). -->
	<key>com.apple.developer.homekit</key>
	<true/>

	<!-- Universal links — printed QR labels (https://xparvu.com/i/<uuid>). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:xparvu.com</string>
	</array>

	<!-- Access WiFi Information — the smart-home network card's real SSID. -->
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
</dict>
</plist>
