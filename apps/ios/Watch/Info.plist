<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE stays
	     YES). Advertising an NSUserActivity for Handoff without declaring
	     its type here throws NSInternalInconsistencyException at first
	     render on a real watch — the app "opens and instantly exits". -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.prvio.page</string>
	</array>
</dict>
</plist>
