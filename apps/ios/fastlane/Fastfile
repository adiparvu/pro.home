require "base64"
require "fileutils"

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    key_id      = ENV["ASC_KEY_ID"]
    issuer_id   = ENV["ASC_ISSUER_ID"]
    key_content = ENV["ASC_KEY_CONTENT"]

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: false
    )

    Dir.chdir("..") do
      sh("xcodegen generate")

      pbxproj_path = "PRVHouse.xcodeproj/project.pbxproj"
      pbxproj = File.read(pbxproj_path)
      has_xcassets     = pbxproj.include?("Assets.xcassets")
      has_correct_type = pbxproj.include?("folder.assetcatalog")
      UI.message("xcassets in project: #{has_xcassets}, correct file type: #{has_correct_type}")

      if has_xcassets && !has_correct_type
        fixed = pbxproj.split("\n").map { |line|
          line.include?("Assets.xcassets") \
            ? line.gsub("lastKnownFileType = folder;", "lastKnownFileType = folder.assetcatalog;") \
            : line
        }.join("\n")
        File.write(pbxproj_path, fixed)
        UI.success("Patched Assets.xcassets to lastKnownFileType = folder.assetcatalog")
      elsif !has_xcassets
        UI.error("Assets.xcassets NOT found in generated project – icons will be missing!")
      end
    end

    keychain_db = "#{Dir.home}/Library/Keychains/build.keychain-db"

    create_keychain(
      name: "build.keychain",
      password: "buildpass",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Import Distribution cert from GitHub Secret (no revocations, no Apple emails).
    cert_p12 = ENV["IOS_DIST_CERTIFICATE_BASE64"]
    cert_pass = ENV["IOS_DIST_CERTIFICATE_PASSWORD"] || ""

    if cert_p12 && !cert_p12.empty?
      cert_path = "/tmp/dist_cert.p12"
      File.binwrite(cert_path, Base64.decode64(cert_p12))
      import_certificate(
        certificate_path: cert_path,
        certificate_password: cert_pass,
        keychain_name: "build.keychain",
        keychain_password: "buildpass"
      )
      UI.success("Distribution certificate imported from secret")

      # import_certificate (unlike `cert`) does NOT install the Apple WWDR
      # intermediate. Without it, `security find-identity -v -p codesigning`
      # reports the leaf cert as an INVALID identity, so sigh fails with
      # "Could not find a matching code signing identity for type 'AppStore'".
      # Install the WWDR intermediates so the chain is complete and the
      # identity is considered valid.
      %w[G3 G6].each do |gen|
        wwdr = "/tmp/AppleWWDRCA#{gen}.cer"
        sh("curl -fsSL https://www.apple.com/certificateauthority/AppleWWDRCA#{gen}.cer -o #{wwdr} 2>&1 || true")
        sh("security import #{wwdr} -k #{keychain_db} -T /usr/bin/codesign 2>&1 || true")
      end
      UI.success("Installed Apple WWDR intermediate certificates")
      sh("security find-identity -v -p codesigning #{keychain_db} 2>&1 || true")
    else
      # Fallback: revoke oldest cert and create a fresh one.
      require "spaceship"
      token = Spaceship::ConnectAPI::Token.create(
        key_id:    key_id,
        issuer_id: issuer_id,
        key:       key_content
      )
      Spaceship::ConnectAPI.token = token
      existing = Spaceship::ConnectAPI::Certificate.all(
        filter: { certificateType: "DISTRIBUTION" }
      )
      if existing.length >= 2
        oldest = existing.min_by { |c| c.expirationDate }
        UI.message("Revoking oldest Distribution cert (#{oldest.id}) to stay under Apple's limit")
        oldest.delete!
      end

      cert(
        api_key:           api_key,
        keychain_path:     keychain_db,
        keychain_password: "buildpass",
        output_path:       "/tmp",
        force:             true
      )
    end

    # Download (or renew) the App Store Distribution provisioning profile.
    sigh(
      api_key: api_key,
      app_identifier: "com.prvhouse.app",
      output_path: "/tmp",
      skip_install: false
    )
    profile_uuid = Actions.lane_context[SharedValues::SIGH_UUID]
    UI.message("App Store Distribution profile UUID: #{profile_uuid}")

    project_dir = File.expand_path("..")

    # Inject the profile UUID into the xcodeproj for the PRVHouse target ONLY.
    # Passing PROVISIONING_PROFILE on the xcodebuild command line applies it to
    # ALL targets (including swift-crypto) which fails in Xcode 26.
    # update_code_signing_settings scopes the change to the specified target.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "#{project_dir}/PRVHouse.xcodeproj",
      targets: ["PRVHouse"],
      build_configurations: ["Release"],
      bundle_identifier: "com.prvhouse.app",
      profile_uuid: profile_uuid,
      code_sign_identity: "Apple Distribution"
    )

    sh(
      "set -o pipefail && xcodebuild archive " \
      "-project #{project_dir}/PRVHouse.xcodeproj " \
      "-scheme PRVHouse " \
      "-configuration Release " \
      "-destination 'generic/platform=iOS' " \
      "-archivePath /tmp/PRVHouse.xcarchive " \
      "-hideShellScriptEnvironment " \
      "DEVELOPMENT_TEAM=SU92TVZT8W " \
      "ASSETCATALOG_COMPILER_APPICON_NAME=AppIcon " \
      "OTHER_CODE_SIGN_FLAGS='--keychain #{keychain_db}' 2>&1"
    )

    # xcodebuild does not compile the asset catalog (XcodeGen project issue).
    # Run actool manually on the archived .app to inject icons before export.
    archive_app = Dir.glob("/tmp/PRVHouse.xcarchive/Products/Applications/*.app").first
    raise "No .app found in /tmp/PRVHouse.xcarchive" unless archive_app
    UI.message("Running actool on archived app: #{archive_app}")

    actool_plist = "/tmp/actool_partial_info.plist"
    FileUtils.rm_f(actool_plist)

    sh(
      "xcrun actool '#{project_dir}/Resources/Assets.xcassets' " \
      "--compile '#{archive_app}' " \
      "--output-format human-readable-text " \
      "--notices --warnings --errors " \
      "--target-device iphone " \
      "--target-device ipad " \
      "--minimum-deployment-target 17.0 " \
      "--platform iphoneos " \
      "--app-icon AppIcon " \
      "--output-partial-info-plist '#{actool_plist}' 2>&1"
    )

    if File.exist?(actool_plist)
      sh("/usr/libexec/PlistBuddy -c 'Merge #{actool_plist}' '#{archive_app}/Info.plist' 2>&1 || true")
      UI.success("Merged actool partial plist into bundle Info.plist")
    end

    export_options_path = "/tmp/ExportOptions.plist"
    File.write(export_options_path, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store</string>
        <key>teamID</key>
        <string>SU92TVZT8W</string>
        <key>signingStyle</key>
        <string>manual</string>
        <key>signingCertificate</key>
        <string>Apple Distribution</string>
        <key>provisioningProfiles</key>
        <dict>
          <key>com.prvhouse.app</key>
          <string>#{profile_uuid}</string>
        </dict>
      </dict>
      </plist>
    PLIST

    sh(
      "set -o pipefail && xcodebuild -exportArchive " \
      "-archivePath /tmp/PRVHouse.xcarchive " \
      "-exportPath /tmp/PRVHouse_ipa " \
      "-exportOptionsPlist #{export_options_path} 2>&1"
    )

    pilot(
      api_key: api_key,
      ipa: "/tmp/PRVHouse_ipa/PRVHouse.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end
end
