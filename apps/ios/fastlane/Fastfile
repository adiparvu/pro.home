require "base64"
require "fileutils"

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    key_id      = ENV["ASC_KEY_ID"]
    issuer_id   = ENV["ASC_ISSUER_ID"]
    key_content = ENV["ASC_KEY_CONTENT"]
    key_path    = "/tmp/AuthKey_#{key_id}.p8"
    File.write(key_path, key_content)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: false
    )

    Dir.chdir("..") do
      sh("xcodegen generate")

      pbxproj_path = "PRVHouse.xcodeproj/project.pbxproj"
      pbxproj = File.read(pbxproj_path)
      has_xcassets     = pbxproj.include?("Assets.xcassets")
      has_correct_type = pbxproj.include?("folder.assetcatalog")
      UI.message("xcassets in project: #{has_xcassets}, correct file type: #{has_correct_type}")

      if has_xcassets && !has_correct_type
        fixed = pbxproj.split("\n").map { |line|
          line.include?("Assets.xcassets") \
            ? line.gsub("lastKnownFileType = folder;", "lastKnownFileType = folder.assetcatalog;") \
            : line
        }.join("\n")
        File.write(pbxproj_path, fixed)
        UI.success("Patched Assets.xcassets to lastKnownFileType = folder.assetcatalog")
      elsif !has_xcassets
        UI.error("Assets.xcassets NOT found in generated project – icons will be missing!")
      end
    end

    keychain_db = "#{Dir.home}/Library/Keychains/build.keychain-db"

    create_keychain(
      name: "build.keychain",
      password: "buildpass",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Revoke existing Distribution certificates so we never hit Apple's limit.
    # The runner is ephemeral: private keys from previous runs are gone, so
    # old certs are unusable anyway.
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: key_id,
      issuer_id: issuer_id,
      filepath: key_path
    )
    Spaceship::ConnectAPI::Certificate.all.each do |c|
      if ["DISTRIBUTION", "IOS_DISTRIBUTION"].include?(c.certificate_type)
        UI.message("Revoking old #{c.certificate_type} certificate #{c.id}")
        Spaceship::ConnectAPI.delete_certificate(certificate_id: c.id)
      end
    end

    # Delete stale profiles too — they are invalid once their cert is revoked,
    # and they squat the base profile name, forcing sigh to create
    # "...AppStore <timestamp>" which won't match the project's
    # PROVISIONING_PROFILE_SPECIFIER.
    Spaceship::ConnectAPI::Profile.all.each do |p|
      UI.message("Deleting old provisioning profile '#{p.name}'")
      p.delete!
    end

    # No force: true here — we already revoked all existing certs above.
    # force: true in cert can accidentally revoke the cert it just created.
    cert(
      api_key: api_key,
      keychain_path: keychain_db,
      keychain_password: "buildpass",
      output_path: "/tmp"
    )

    # Create App Store provisioning profile
    sigh(
      api_key: api_key,
      app_identifier: "com.prvhouse.app",
      force: true,
      output_path: "/tmp"
    )

    profile_uuid = lane_context[SharedValues::SIGH_UUID]
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]

    # Install the profile in both locations: pre-Xcode-16 and Xcode 16+ paths
    [
      "#{Dir.home}/Library/MobileDevice/Provisioning Profiles",
      "#{Dir.home}/Library/Developer/Xcode/UserData/Provisioning Profiles"
    ].each do |dir|
      FileUtils.mkdir_p(dir)
      FileUtils.cp(profile_path, File.join(dir, "#{profile_uuid}.mobileprovision"))
    end

    project_dir = File.expand_path("..")

    sh(
      "set -o pipefail && xcodebuild archive " \
      "-project #{project_dir}/PRVHouse.xcodeproj " \
      "-scheme PRVHouse " \
      "-configuration Release " \
      "-destination 'generic/platform=iOS' " \
      "-archivePath /tmp/PRVHouse.xcarchive " \
      "-hideShellScriptEnvironment " \
      "DEVELOPMENT_TEAM=SU92TVZT8W " \
      "ASSETCATALOG_COMPILER_APPICON_NAME=AppIcon " \
      "OTHER_CODE_SIGN_FLAGS='--keychain #{keychain_db}' 2>&1"
    )

    # xcodebuild does not compile the asset catalog (XcodeGen project issue).
    # Run actool manually on the archived .app to inject icons before export.
    archive_app = Dir.glob("/tmp/PRVHouse.xcarchive/Products/Applications/*.app").first
    raise "No .app found in /tmp/PRVHouse.xcarchive" unless archive_app
    UI.message("Running actool on archived app: #{archive_app}")

    actool_plist = "/tmp/actool_partial_info.plist"
    FileUtils.rm_f(actool_plist)

    sh(
      "xcrun actool '#{project_dir}/Resources/Assets.xcassets' " \
      "--compile '#{archive_app}' " \
      "--output-format human-readable-text " \
      "--notices --warnings --errors " \
      "--target-device iphone " \
      "--target-device ipad " \
      "--minimum-deployment-target 17.0 " \
      "--platform iphoneos " \
      "--app-icon AppIcon " \
      "--output-partial-info-plist '#{actool_plist}' 2>&1"
    )

    # Merge actool-generated keys (CFBundleIconName etc.) into the bundle Info.plist
    if File.exist?(actool_plist)
      sh("/usr/libexec/PlistBuddy -c 'Merge #{actool_plist}' '#{archive_app}/Info.plist' 2>&1 || true")
      UI.success("Merged actool partial plist into bundle Info.plist")
    end

    export_options_path = "/tmp/ExportOptions.plist"
    File.write(export_options_path, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store</string>
        <key>teamID</key>
        <string>SU92TVZT8W</string>
        <key>signingStyle</key>
        <string>manual</string>
        <key>provisioningProfiles</key>
        <dict>
          <key>com.prvhouse.app</key>
          <string>#{profile_uuid}</string>
        </dict>
      </dict>
      </plist>
    PLIST

    sh(
      "set -o pipefail && xcodebuild -exportArchive " \
      "-archivePath /tmp/PRVHouse.xcarchive " \
      "-exportPath /tmp/PRVHouse_ipa " \
      "-exportOptionsPlist #{export_options_path} 2>&1"
    )

    pilot(
      api_key: api_key,
      ipa: "/tmp/PRVHouse_ipa/PRVHouse.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end
end
