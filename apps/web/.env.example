# Supabase — get these from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic — required for ARIA (get from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Next.js public site URL (needed for auth redirects in production)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Resend — required for invite emails via the send-invite-email Edge Function
# Set as a Supabase secret: supabase secrets set RESEND_API_KEY=re_...
# RESEND_API_KEY=re_...
