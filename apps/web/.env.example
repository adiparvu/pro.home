# ─────────────────────────────────────────────────────────────────────────────
# Supabase — required for all DB / auth operations
# Get from: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-side only, required for account deletion
# NEVER commit this key. Set it only in your server environment / Vercel env vars.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic — required for ARIA
# Get from: console.anthropic.com
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────────────────────────────────────
# Site URL — required in production for invite links and auth redirects
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# Resend — required for invite emails via the send-invite-email Edge Function
# Set as a Supabase secret: supabase secrets set RESEND_API_KEY=re_...
# ─────────────────────────────────────────────────────────────────────────────
# RESEND_API_KEY=re_...

# ─────────────────────────────────────────────────────────────────────────────
# Sentry — optional; error tracking silently disabled when unset
# Get from: sentry.io → Project Settings → DSN
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=prv-house
# SENTRY_AUTH_TOKEN=sntrys_...   ← needed for source-map uploads in CI

# ─────────────────────────────────────────────────────────────────────────────
# Upstash Redis — optional; upgrades ARIA rate limiter to multi-instance safe
# Get from: upstash.com → Create Database → REST API
# ─────────────────────────────────────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxx...

# ─────────────────────────────────────────────────────────────────────────────
# Web Push — required for push notifications
# Generate once: node -e "console.log(require('web-push').generateVAPIDKeys())"
# After deploy, schedule POST /api/push/dispatch (header x-cron-secret) every
# few minutes — e.g. Vercel Cron or Supabase pg_net.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BPxx...
# VAPID_PRIVATE_KEY=xxx          ← server-side only, never commit
VAPID_SUBJECT=mailto:admin@your-domain.com
# CRON_SECRET=random-long-string ← protects the dispatch endpoint
